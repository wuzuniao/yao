{
  // 鸿蒙（HarmonyOS）工程模块配置增量覆盖文件
  // --------------------------------------------------------------------------
  // HBuilderX 编译鸿蒙工程时，会将本文件与内置模板的 module.json5 合并。
  // 仅在此声明本项目额外需要的系统权限，其余字段沿用官方模板，避免覆盖默认配置。
  // 说明：
  //   - ohos.permission.ACCESS_BIOMETRIC：指纹登录（uni.startSoterAuthentication
  //     及 checkIsSupportSoterAuthentication / checkIsSoterEnrolledInDevice
  //     自 HBuilderX 4.31 起在鸿蒙端可用，但必须声明该权限，否则调用直接失败）。
  //   - 鸿蒙端不集成友盟推送：xtf-umengpush 为付费加密 UTS 插件，发行鸿蒙须走
  //     DCloud 云端编译换取 module.har，而该链路仅支持 uni-app x 工程，本项目为
  //     传统 uni-app，故 module.har 永不生成、ohpm 报 00617202。已在插件
  //     package.json 将 harmony 置为 "-"，友盟相关权限与 AbilityStage 预初始化
  //     桥接（原 MyAbilityStage.ets）一并移除。鸿蒙提醒走邮件 / 站内信通道。
  //   - 注意：HBuilderX 合并本增量文件时不会自动注入 module 的若干必填字段，必须在此
  //     显式声明，否则产物 entry/src/main/module.json5 缺失字段导致 hvigor 报错
  //     （2026-08-09 连续踩坑）：
  //       * module.type            缺失 → 00303196 "Unable to obtain the module type"
  //       * module.deliveryWithInstall 缺失 → 00303038 schema "must have required
  //         property 'deliveryWithInstall'"
  //       * module.mainElement    缺失 → 同上 schema（参照 HBuilderX 生成的 EntryAbility）
  //     补 deliveryWithInstall:true 与 mainElement:"EntryAbility" 即可通过 schema 校验。
  "module": {
    "name": "entry",
    "type": "entry",
    "mainElement": "EntryAbility",
    "deliveryWithInstall": true,
    "requestPermissions": [
      {
        "name": "ohos.permission.ACCESS_BIOMETRIC",
        "reason": "$string:reason_access_biometric",
        "usedScene": {
          "when": "inuse"
        }
      }
    ]
  }
}
