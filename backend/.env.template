# ============================================================
# 后端环境变量模板（复制为 .env 后填入实际值，.env 不提交 Git）
# ============================================================

# ---------------------- 项目基本信息 ----------------------
# 项目名称（FastAPI 文档标题等展示用途，有代码默认值，可按需修改）
PROJECT_NAME=无足鸟按时吃药打卡
# API 路由前缀（一般无需修改）
API_V1_STR=/api/v1

# ---------------------- 数据库配置 ----------------------
# MariaDB 连接字符串
# 格式：mysql+asyncmy://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 开发环境：127.0.0.1:3306；生产环境：mariadb 容器服务名或内网 IP
DATABASE_URL=mysql+asyncmy://root:your_password@127.0.0.1:3306/wuzuniao_yao?charset=utf8mb4

# ------------------- 微信小程序配置 -------------------
# 微信公众平台 → 开发管理 → 开发设置 中获取
WX_APPID=your_wx_appid
WX_APP_SECRET=your_wx_app_secret

# 微信订阅消息（一次性订阅模板，用于打卡时间到达后下发提醒）
# 模板在微信公众平台 → 订阅消息 → 我的模板 中创建，标题「打卡提醒」
# 字段：thing4=打卡名称 thing3=备注 time13=提醒时间 thing12=机构名称
WX_SUBSCRIBE_TEMPLATE_ID=your_wx_subscribe_template_id
# 点击订阅消息后跳转的小程序页面路径（#ifdef MP-WEIXIN 页面路径，不含域名）
WX_SUBSCRIBE_PAGE=/pages/index/index
# 订阅消息「机构名称」字段（thing12）展示值
WX_SUBSCRIBE_ORG_NAME=无足鸟

# ------------------- 友盟+ U-Push 配置 -------------------
# App 端离线推送（Android 六大厂商通道 / iOS APNs / Harmony 华为推送），
# Android、iOS、Harmony 在友盟控制台为三个独立应用，各一套密钥
# 在友盟+ 控制台 → U-Push → 应用管理 → 应用信息 中获取
UMENG_ANDROID_APP_KEY=your_umeng_android_app_key
UMENG_ANDROID_MASTER_SECRET=your_umeng_android_master_secret
# iOS 应用暂未创建，先保留配置项占位，待苹果开发者账号就绪后填入
UMENG_IOS_APP_KEY=
UMENG_IOS_MASTER_SECRET=
# 鸿蒙应用密钥（应用平台 Harmony）
UMENG_HARMONY_APP_KEY=your_umeng_harmony_app_key
UMENG_HARMONY_MASTER_SECRET=your_umeng_harmony_master_secret
# 推送环境开关：true=生产环境，false=测试环境
# 仅 iOS 生效（决定走 APNs 生产证书还是开发证书）；Android / Harmony 侧友盟忽略该字段
UMENG_PRODUCTION_MODE=true
# 点击 App 推送通知后跳转的页面路径（App 端由前端 reLaunch 使用，不含域名）
UMENG_PUSH_PAGE=/pages/index/index

# ------------------- 数据加密密钥 -------------------
# AES-256-GCM 加密密钥（base64 编码的 32 字节密钥）
# 用于加密邮件客户端专用密码等敏感信息，请妥善保管，泄露后所有加密数据需重新加密
# 生成方式：python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_SECRET_KEY=your_base64_encoded_32_byte_key

# ------------------- auth 统一认证服务配置 -------------------
# 用户模块已独立为 auth 服务（独立域名部署），登录/注册/令牌签发均在 auth 侧完成；
# 本服务持 auth 公钥本地验签 access_token（RS256），需用户信息时经 /internal/* 接口查询
# auth 服务基础地址：开发环境 http://localhost:10000；生产环境 https://auth.wuzuniao.com
AUTH_BASE_URL=https://auth.wuzuniao.com
# 令牌签发方标识（须与 auth 服务 .env 的 ISSUER 完全一致，否则验签不通过）
AUTH_ISSUER=https://auth.wuzuniao.com
# 服务间通信令牌（/internal/* 双向校验；与 auth 服务 .env 的 SERVICE_TOKEN 及
# 其 oauth_clients 表 yao 行的 callback_service_token 保持一致）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SERVICE_TOKEN=your_service_token
# 令牌撤销增量同步间隔（秒）：改密码/退出/删号后旧令牌在本服务的最大残留窗口
REVOCATION_SYNC_INTERVAL_SECONDS=300

# ------------------- CORS 跨域配置 -------------------
# 允许跨域访问的源（逗号分隔）
# 微信小程序请求不携带 Origin 头，不受 CORS 限制；此项主要约束 Web 端访问
# 生产环境：https://yao.wuzuniao.com
# 本地开发：http://localhost:8000
CORS_ALLOW_ORIGINS=https://yao.wuzuniao.com,http://localhost:8000
